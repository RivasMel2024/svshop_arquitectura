# Variables de entorno para Docker Compose
# Copia este archivo a .env y ajusta los valores

# Frontend (build args)
# Esta variable se inyecta en el build del frontend
# Docker local: http://localhost:3000/api
# Producción: https://tu-dominio.com/api (la URL pública del backend)
VITE_API_URL=http://localhost:3000/api