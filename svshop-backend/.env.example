# Variables de entorno para svshop-backend (Monolito Modular)
# Copia este archivo a .env y ajusta los valores según el ambiente

NODE_ENV=production
PORT=3000

# MongoDB - Base de datos principal del monolito
# Colecciones: users, products, carts, invoices
# Reemplaza <usuario>, <password>, <cluster> con tus credenciales
MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/svshop_main?retryWrites=true&w=majority&appName=Cluster0

# JWT - Autenticación
# IMPORTANTE: Cambiar por un secreto seguro de al menos 32 caracteres aleatorios
JWT_SECRET=CAMBIAR_POR_SECRETO_SEGURO_EN_PRODUCCION_MIN_32_CARACTERES
JWT_EXPIRES_IN=7d

# Bcrypt - Hash de contraseñas
BCRYPT_SALT_ROUNDS=10

# Seguridad de login
LOGIN_MAX_ATTEMPTS=3
LOGIN_LOCK_MINUTES=15

# Límites de archivos
MAX_IMAGE_SIZE_MB=3

# URL del microservicio de órdenes
# Docker: http://svshop-orders-service:3001
# Desarrollo local: http://localhost:3001
ORDERS_SERVICE_URL=http://svshop-orders-service:3001
