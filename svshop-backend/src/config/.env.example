# Environment Variables Template - SvShop Backend
# Copia este archivo y renómbralo según el ambiente:
# - .env.development (desarrollo local)
# - .env.production (producción)

NODE_ENV=development
PORT=8080

# MongoDB - Usa la URI correspondiente a tu ambiente
# Desarrollo: mongodb://localhost:27017/svshop_main
# Producción: mongodb+srv://user:pass@cluster.mongodb.net/svshop
MONGO_URI=

# JWT - Configura un secreto seguro en producción
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=12h

# Bcrypt
BCRYPT_SALT_ROUNDS=10

# Límites
MAX_IMAGE_SIZE_MB=3

# Microservicio de Órdenes
# development: http://localhost:3001
# production:  http://svshop-orders-service:3001
ORDERS_SERVICE_URL=