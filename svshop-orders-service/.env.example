# Variables de entorno para svshop-orders-service (Microservicio de Órdenes)
# Docker/Production
 
NODE_ENV=production
PORT=3001
 
# MongoDB - Base de datos independiente del microservicio
# Colecciones: orders ÚNICAMENTE
# IMPORTANTE: Usar una base de datos DIFERENTE a svshop_main
MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/svshop_main?retryWrites=true&w=majority&appName=Cluster0
 
# JWT - DEBE COINCIDIR CON EL SECRET DEL BACKEND MONOLITO
# En producción, usar la MISMA clave que svshop-backend para validar tokens
JWT_SECRET=CAMBIAR_POR_SECRETO_SEGURO_EN_PRODUCCION_MIN_32_CARACTERES
JWT_EXPIRES_IN=12h
 
# Email (Nodemailer / SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=rivasmelisa2024@gmail.com
SMTP_PASS=nhxg jvxh fjyf gcli
SMTP_FROM=rivasmelisa2024@gmail.com
 
# Integración con backend monolito para stock
MONOLITH_API_URL=http://svshop-backend:3000
INTERNAL_API_KEY=your-internal-api-key