# Variables de entorno para svshop-orders-service (Microservicio de Órdenes)
# Copia este archivo a .env y ajusta los valores según el ambiente

NODE_ENV=production
PORT=3001

# MongoDB - Base de datos independiente del microservicio
# Colecciones: orders ÚNICAMENTE
# IMPORTANTE: Usar una base de datos DIFERENTE a svshop_main
# Reemplaza <usuario>, <password>, <cluster> con tus credenciales
MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/svshop_orders?retryWrites=true&w=majority&appName=Cluster0
